    "Shows the device with its battery when audio switches to AirPods, Bluetooth or AirPlay devices.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 AirPods, Bluetooth, AirPlay 기기로 바뀌면 기기와 배터리를 보여 줘요."
          }
        }
      }
    },
    "Something stirs in Cerulean Cave…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미지의동굴에서 무언가 깨어났어요…"
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했어요"
