            "value": "버전 %@"
          }
        }
      }
    },
    "Wait for an answer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 대기 시간"
          }
        }
      }
    },
    "Waiting for you": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 대기 중"
          }
        }
      }
    },
    "Water": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물"
          }
        }
      }
    },
    "Welcome to pokove": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pokove에 오신 걸 환영해요"
          }
        }
      }
    },
    "When Claude finishes": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 작업을 마쳤을 때"
          }
        }
      }
    },
    "When Claude needs permission or input": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 권한이나 입력이 필요할 때"
          }
        }
      }
    },
    "When a turn fails": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 실패했을 때"
          }
        }
      }
    },
    "When the app running Claude isn't in front, pokove holds the request and shows Allow / Deny in the notch. If you don't answer in time, or switch to that app, Claude asks in its own window as usual.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude를 실행 중인 앱이 앞에 없으면 pokove가 요청을 잠시 붙잡고 노치에 허용 / 거부를 보여 줘요. 시간 안에 답하지 않거나 그 앱으로 전환하면 평소처럼 Claude 창에서 물어봐요."
          }
        }
      }
    },
    "While Claude or Codex works, your party of up to three rides Kanto's stage lines, battling wild Pokémon. Gym leaders, legendaries and two daily dungeons are challenges you start. New Pokémon turn up along the way, and stardust buys gacha pulls. Badges raise the level cap.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude나 Codex가 일하는 동안 최대 3마리 파티가 관동의 스테이지 노선을 따라 야생 포켓몬과 싸워요. 체육관 관장, 전설 포켓몬, 두 가지 데일리 던전은 직접 시작하는 도전이에요. 가는 길에 새 포켓몬이 합류하고, 별의모래로 뽑기를 할 수 있어요. 배지를 따면 레벨 상한이 올라가요."
          }
        }
      }
    },
    "Works with Music, Spotify, browsers and any app that reports to Control Center.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악, Spotify, 브라우저 등 제어 센터에 표시되는 모든 앱과 함께 동작해요."
          }
        }
      }
    },
    "Writing": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 중"
          }
        }
      }
    },
    "Writing %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 작성 중"
          }
        }
      }
    },
    "You're the Champion!": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "챔피언이 되었어요!"
          }
        }
      }
    },
    "Your Pokémon, Pokédex and journey will be cleared. This can't be undone.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포켓몬, 도감, 여정이 모두 지워져요. 되돌릴 수 없어요."
          }
        }
      }
    },
    "Your party travels in the MacBook notch while your agent works.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 일하는 동안 MacBook 노치 속 파티가 여행해요."
          }
        }
      }
    },
    "app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        }
      }
    },
    "items": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목"
          }
        }
      }
    },
    "left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남았어요"
          }
        }
      }
    },
    "now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금"
          }
        }
      }
    },
    "pokove": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pokove"
          }
        }
      }
    },
    "pokove Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pokove 설정"
          }
        }
      }
    },
    "pokove adds small hooks to ~/.claude/settings.json that forward Claude's events to 127.0.0.1 with curl, and stay silent when pokove isn't running. Your other settings are kept, and the previous file is saved as settings.json.pokove-backup. Sessions that are already running pick up the hooks after a restart.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pokove는 ~/.claude/settings.json에 작은 훅을 추가해 Claude의 이벤트를 curl로 127.0.0.1에 전달해요. pokove가 꺼져 있으면 아무 일도 하지 않아요. 다른 설정은 그대로 두고, 기존 파일은 settings.json.pokove-backup으로 저장해요. 이미 실행 중인 세션은 다시 시작해야 훅이 적용돼요."
          }
        }
      }
    },
    "pokove listens for the volume and brightness keys and draws its own HUD in the notch. Nothing else is read.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pokove는 음량·밝기 키만 감지해 노치에 자체 HUD를 그려요. 그 밖의 입력은 읽지 않아요."
          }
        }
      }
    },
    "working": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중"
          }
        }
      }
    },
    "~/.claude/settings.json could not be parsed: %@. Fix the file and try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.claude/settings.json을 읽을 수 없어요: %@. 파일을 고친 뒤 다시 시도하세요."
          }
        }
      }
    },
    "· %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· %@"
          }
        }
      }
    },
    "×%lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "×%lld"
          }
        }
      }
    },
    "–": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "–"
          }
        }
      }
    },
    "한국어": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한국어"
          }
        }
      }
    }
  },
  "version": "1.0"
}
