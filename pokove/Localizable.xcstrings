    "Update": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트"
          }
        }
      }
    },
    "Updating tasks": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 갱신 중"
          }
        }
      }
    },
