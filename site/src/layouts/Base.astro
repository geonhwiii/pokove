---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { strings, type Lang } from '../i18n';
import { url } from '../config';

interface Props {
  lang: Lang;
  /** For a page other than the landing page. */
  title?: string;
  /** Its path below the landing page ("journey"), for the canonical and language links. */
  page?: string;
  /** Keeps the page out of search results, like the download page. */
  noindex?: boolean;
  description?: string;
}
const { lang, title, page = '', noindex = false, description } = Astro.props;
const t = strings[lang];
const canonical = new URL(url((lang === 'ko' ? '' : 'en/') + page), Astro.site);
const alternates = [
  { hreflang: 'ko', href: new URL(url(page), Astro.site) },
  { hreflang: 'en', href: new URL(url('en/' + page), Astro.site) },
];
const image = new URL(url('icon-512.png'), Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description ?? t.description} />
    <meta name="theme-color" content="#2446e0" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>
