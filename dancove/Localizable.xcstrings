            "state": "translated",
            "value": "오늘 %lld회 · %@"
          }
        }
      }
    },
    "Too quick for a bite": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입질이 오기엔 너무 짧았어요"
          }
        }
      }
    },
    "Trackpad gestures": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드 제스처"
          }
        }
      }
    },
    "Turn on the Claude integration to fish.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낚시를 하려면 Claude 연동을 켜 주세요."
          }
        }
      }
    },
    "Unavailable": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 없음"
          }
