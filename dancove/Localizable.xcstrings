          }
        }
      }
    },
    "Show waveform": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형 표시"
          }
        }
      }
    },
    "Shows the device with its battery when audio switches to AirPods, Bluetooth or AirPlay devices.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 AirPods, Bluetooth, AirPlay 기기로 바뀌면 기기와 배터리를 보여 줘요."
          }
        }
      }
    },
    "Shrimp": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새우"
          }
        }
      }
    },
    "Slow and steady. Its builds take 45 minutes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "느리지만 꾸준하다. 빌드는 45분 걸린다."
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제가 발생했어요"
          }
        }
      }
    },
    "Sound": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사운드"
          }
        }
      }
    },
    "Source": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스"
          }
        }
      }
    },
    "Sparkfish": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스파크피시"
          }
        }
      }
    },
    "Species found": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견한 어종"
          }
        }
      }
    },
    "Squid": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오징어"
          }
        }
      }
    },
    "Start Claude or Codex anywhere — what they're doing shows up here.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 Claude나 Codex를 시작하세요. 하는 일이 여기에 나타나요."
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태"
          }
        }
      }
    },
    "Stay quiet while Claude's app is in front": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 앱이 앞에 있으면 조용히"
          }
        }
      }
    },
    "Still fizzing with last night's energy drink.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어젯밤 에너지 드링크가 아직 톡 쏜다."
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지됨"
          }
        }
      }
    },
    "Swims upstream against every code review.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 코드 리뷰를 거슬러 헤엄쳐 오른다."
          }
        }
      }
    },
    "Swipe down on the notch to open it or switch activities, swipe up to close, swipe sideways to skip tracks.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에서 아래로 쓸면 열리거나 활동이 바뀌고, 위로 쓸면 닫히고, 옆으로 쓸면 곡이 넘어가요."
          }
        }
      }
    },
    "Swordfish": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황새치"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템"
          }
        }
      }
    },
    "Tastes best grilled at midnight after a deploy.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배포 끝난 자정에 구워 먹으면 제일 맛있다."
          }
        }
      }
    },
    "The father carries the eggs. And the on-call pager.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알은 아빠가 품는다. 온콜 호출기도."
          }
        }
      }
    },
    "The fish got away": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물고기가 도망갔어요"
          }
        }
      }
    },
    "The largest creature ever. About the size of node_modules.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지구상 가장 큰 생물. node_modules만 하다."
          }
        }
      }
    },
    "The line snapped": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낚싯줄이 끊어졌어요"
          }
        }
      }
    },
    "The notch opens to what's going on: music while it plays, Claude while it works.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 열면 상황에 맞는 화면이 나와요. 음악이 재생 중이면 음악, Claude가 작업 중이면 Claude."
          }
        }
      }
    },
    "The notch opens where you left it. A Claude permission request still comes first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 열면 마지막으로 본 화면이 나와요. Claude 권한 요청은 그래도 먼저 보여줘요."
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각 중…"
          }
        }
      }
    },
    "This day is clear": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 일정이 없어요"
          }
        }
      }
    },
    "Thought extinct, like that legacy service still in production.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멸종한 줄 알았다. 아직 운영 중인 그 레거시 서비스처럼."
          }
        }
      }
    },
    "Tint with album artwork": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 아트 색으로 물들이기"
          }
        }
      }
    },
    "Tiny, but a whole school of them could refactor a codebase.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작지만 떼로 몰려오면 코드베이스 하나쯤은 리팩터링한다."
          }
        }
      }
    },
    "To paste into the app you're using, dancove presses ⌘V for you, which needs Accessibility access. Without it, items are copied and you paste them yourself.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 쓰는 앱에 바로 붙여넣으려면 dancove가 ⌘V를 대신 눌러야 해서 손쉬운 사용 권한이 필요해요. 권한이 없으면 복사만 되고 붙여넣기는 직접 하시면 돼요."
          }
        }
      }
    },
    "To-dos": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘"
          }
        }
      }
    },
    "Today %lld · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Today %1$lld · %2$@"
