      }
    },
    "Unique": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유니크"
          }
        }
      }
    },
    "Unknown fish": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 물고기"
          }
        }
      }
    },
    "Unpin": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 해제"
          }
        }
      }
    },
    "Untitled": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 없음"
          }
        }
      }
    },
    "Update": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트"
          }
        }
      }
    },
    "Updating tasks": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 갱신 중"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %@"
          }
        }
      }
    },
    "Wait for an answer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 대기 시간"
          }
        }
      }
    },
    "Waiting for you": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 대기 중"
          }
        }
      }
    },
    "Walks sideways, like a merge that shouldn't have happened.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆으로 걷는다. 하지 말았어야 할 머지처럼."
          }
        }
      }
    },
    "Welcome to dancove": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dancove에 오신 걸 환영해요"
          }
        }
      }
    },
    "When Claude finishes": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 작업을 마쳤을 때"
          }
        }
      }
    },
    "When Claude needs permission or input": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 권한이나 입력이 필요할 때"
          }
        }
      }
    },
    "When a turn fails": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 실패했을 때"
          }
        }
      }
    },
    "When the app running Claude isn't in front, dancove holds the request and shows Allow / Deny in the notch. If you don't answer in time, or switch to that app, Claude asks in its own window as usual.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude를 실행 중인 앱이 앞에 없으면 dancove가 요청을 잠시 붙잡고 노치에 허용 / 거부를 보여 줘요. 시간 안에 답하지 않거나 그 앱으로 전환하면 평소처럼 Claude 창에서 물어봐요."
          }
        }
      }
    },
    "Works with Music, Spotify, browsers and any app that reports to Control Center.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악, Spotify, 브라우저 등 제어 센터에 표시되는 모든 앱과 함께 동작해요."
          }
        }
      }
    },
    "Writing": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 중"
          }
        }
      }
    },
    "Writing %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 작성 중"
          }
        }
      }
    },
    "app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱"
          }
        }
      }
    },
    "dancove": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dancove"
          }
        }
      }
    },
    "dancove Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dancove 설정"
          }
        }
      }
    },
    "dancove adds small hooks to ~/.claude/settings.json that forward Claude's events to 127.0.0.1 with curl, and stay silent when dancove isn't running. Your other settings are kept, and the previous file is saved as settings.json.dancove-backup. Sessions that are already running pick up the hooks after a restart.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dancove는 ~/.claude/settings.json에 작은 훅을 추가해 Claude의 이벤트를 curl로 127.0.0.1에 전달해요. dancove가 꺼져 있으면 아무 일도 하지 않아요. 다른 설정은 그대로 두고, 기존 파일은 settings.json.dancove-backup으로 저장해요. 이미 실행 중인 세션은 다시 시작해야 훅이 적용돼요."
          }
        }
      }
    },
    "dancove listens for the volume and brightness keys and draws its own HUD in the notch. Nothing else is read.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dancove는 음량·밝기 키만 감지해 노치에 자체 HUD를 그려요. 그 밖의 입력은 읽지 않아요."
          }
        }
      }
    },
    "items": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목"
          }
        }
      }
    },
    "left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남았어요"
          }
        }
      }
    },
    "now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금"
          }
        }
      }
    },
    "working": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중"
          }
        }
      }
    },
    "~/.claude/settings.json could not be parsed: %@. Fix the file and try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.claude/settings.json을 읽을 수 없어요: %@. 파일을 고친 뒤 다시 시도하세요."
          }
        }
      }
    },
    "· %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· %@"
          }
        }
      }
    },
    "· %lld nibbles": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "· %lld nibble"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "· %lld nibbles"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· 입질 %lld회"
          }
        }
      }
    },
    "· New record": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· 최고 기록"
          }
        }
      }
    },
    "· Trophy": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· 월척!"
          }
        }
      }
    },
    "×%lld · best %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "×%1$lld · best %2$@"
