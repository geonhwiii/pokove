        }
      }
    },
    "AUTO: the boss is challenged as soon as the line is cleared, and again after training": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AUTO: 노선을 다 깨면 바로 보스에게 도전하고, 지면 수련 뒤 다시 도전해요"
          }
        }
